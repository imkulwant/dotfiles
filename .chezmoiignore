# Ignore README, LICENSE, or other non-dotfile files

README.md
LICENSE

# Repo-only files: planning docs, doctor scaffolding, task runner, templates.
# These live in the source repo but should never be written to $HOME.
OVERHAUL_PLAN.md
SWOT.md
Brewfile
docs
scripts
justfile
templates

# macOS metadata - Finder drops these into every visited directory.
# .gitignore already blocks tracking; this stops chezmoi from surfacing
# them via 'chezmoi add' or applying stray ones to $HOME.
.DS_Store
**/.DS_Store

# SSH: nothing under ~/.ssh is tracked. These guards stop private keys,
# known_hosts, and the agent socket from ever entering the source tree.
.ssh/id_*
.ssh/*.pub
.ssh/known_hosts
.ssh/known_hosts.old
.ssh/agent
.ssh/agent/**

# mise tool installs — managed by mise, never tracked by chezmoi.
# Only ~/.config/mise/config.toml belongs in chezmoi (added in Phase L).
.local/share/mise
.local/share/mise/**

# Neovim plugin state — managed by vim.pack, never tracked by chezmoi.
# Only ~/.config/nvim (init.lua, nvim-pack-lock.json) belongs in chezmoi.
.local/share/nvim
.local/share/nvim/**
