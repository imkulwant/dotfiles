# ── Global defaults ────────────────────────────────────────────────────────────
Host *
    UseKeychain yes
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519

# ── GitHub ────────────────────────────────────────────────────────────────────
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    AddKeysToAgent yes
    UseKeychain yes

# ── Local machines ─────────────────────────────────────────────────────────────
{{- range $alias, $cfg := .ssh.local_hosts }}
Host {{ $alias }}
    HostName {{ $cfg.host }}
    User {{ $cfg.user }}
{{ end }}
